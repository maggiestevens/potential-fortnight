<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kitchen Smart Hub</title>
    <style>
        body {
            background-color: #121212;
            color: #ffffff;
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 15px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            grid-template-rows: auto 1fr;
            gap: 15px;
            height: 100vh;
            box-sizing: border-box;
        }
        .card {
            background-color: #1e1e1e;
            border-radius: 12px;
            padding: 15px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.3);
        }
        .header-block { grid-column: span 2; display: flex; justify-content: space-between; align-items: center; }
        #time { font-size: 2.5rem; font-weight: bold; }
        #weather { font-size: 1.2rem; text-align: right; }
        .recipe-iframe { width: 100%; height: 100%; border: none; border-radius: 8px; }
        .timer-container button { padding: 10px; margin-top: 10px; width: 100%; font-size: 1.1rem; }
    </style>
</head>
<body>

    <!-- 1. TIME & WEATHER HEADER -->
    <div class="card header-block">
        <div id="time">00:00 PM</div>
        <div id="weather">Loading Weather...</div>
    </div>

    <!-- 2. RECIPE EMBED -->
    <!-- Note: Replace URL with your site. Some sites block embedding; if so, change this to a clickable launch image instead -->
    <div class="card">
        <h3>Recipes</h3>
        <iframe class="recipe-iframe" src="https://allrecipes.com"></iframe>
    </div>

    <!-- 3. TIMERS & CALENDAR -->
    <div class="card timer-container">
        <h3>Kitchen Timer</h3>
        <div id="timer-display" style="font-size: 2rem; text-align: center; margin: 10px 0;">05:00</div>
        <button onclick="startTimer()">Start 5 Min Timer</button>
    </div>

    <script>
        // Digital Clock Logic
        function updateClock() {
            const now = new Date();
            document.getElementById('time').innerText = now.toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});
        }
        setInterval(updateClock, 1000);
        updateClock();

        // Simple Timer Logic
        let timeRemaining = 300; 
        function startTimer() {
            const interval = setInterval(() => {
                if(timeRemaining <= 0) {
                    clearInterval(interval);
                    alert("Timer Finished!");
                } else {
                    timeRemaining--;
                    let mins = Math.floor(timeRemaining / 60);
                    let secs = timeRemaining % 60;
                    document.getElementById('timer-display').innerText = `${mins}:${secs < 10 ? '0' : ''}${secs}`;
                }
            }, 1000);
        }
    </script>
</body>
</html>
